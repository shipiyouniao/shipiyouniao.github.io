{
  "name": "shipiyouniao-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src index.html vite.config.js playwright.config.js package.json tests/browser .github/workflows/pages.yml",
