  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^11.17.2",
    "shiki": "^4.4.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
